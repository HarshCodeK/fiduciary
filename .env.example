# Razorpay (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# HMAC signing for consent tokens (NOT your Razorpay secret)
CONSENT_TOKEN_SECRET=

# High-value purchase threshold in paise (₹2,000 = 200000)
HIGH_VALUE_THRESHOLD_PAISE=200000

# Demo mode marks simulated responses in UI
DEMO_MODE=true

# Control plane port
PORT=4100
